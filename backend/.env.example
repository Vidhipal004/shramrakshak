APP_NAME=ShramRakshak API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Set these from Supabase Project Settings. Use only the public anon/publishable
# key here. The service_role/secret key is not required by this application.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Expo Go's host changes at runtime. Add this same pattern under Supabase Auth
# > URL Configuration > Redirect URLs. The API only accepts local Expo hosts.
SUPABASE_EMAIL_REDIRECT_URL=exp://**/--/auth/callback

# Optional. Enables multimodal text/image job-offer extraction.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Use SQLite for local-only work, or set your Supabase PostgreSQL connection
# string. URL-encode special characters in the database password.
DATABASE_URL=sqlite:///./shramrakshak.db
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Pydantic settings accepts JSON for list-valued environment variables.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:8081"]
